# Runtime mode used by scripts and compose.
APP_ENV=local

# Installer/runtime paths. Leave empty to use defaults from install.sh.
OZSH_REPO=https://github.com/SnakePilot10/ozsh
OZSH_INSTALL_DIR=
OZSH_BIN_DIR=
OZSH_YES=0
OZSH_APPLY=0
OZSH_UPDATE_PATH=0

# Docker/GHCR image name.
GHCR_IMAGE=ghcr.io/snakepilot10/ozsh

# Optional deploy targets. Do not put secrets here; use CI secrets instead.
DEPLOY_TARGET_STAGING=
DEPLOY_TARGET_PRODUCTION=

# Optional local deploy commands. Prefer CI secrets for real values.
DEPLOY_STAGING_COMMAND=
DEPLOY_PROD_COMMAND=
